# ============================================================
# flight-agent environment variables
# ============================================================
# Copy this file to .env for local development.
# NEVER commit .env or any file containing real credentials.
# In GitHub Actions, set secrets via:
#   Settings > Secrets and variables > Actions > New repository secret
# ============================================================

# ----------------------------------------------------------
# Required – ntfy.sh push notifications
# ----------------------------------------------------------

# Your private ntfy topic name.
# Pick something hard to guess (e.g. flight-deals-sefi-a7x9q2).
# Anyone who knows this name can subscribe, so treat it like a password.
# No account needed – just choose a name and subscribe on your device.
NTFY_TOPIC=flight-deals-yourname-randomsuffix

# ----------------------------------------------------------
# Optional – ntfy server (leave blank to use ntfy.sh)
# ----------------------------------------------------------

# Use this only if you run a self-hosted ntfy server.
# Default: https://ntfy.sh
# NTFY_SERVER=https://ntfy.sh

# ----------------------------------------------------------
# Optional – notification behaviour
# ----------------------------------------------------------

# Send a notification even when no new deals are found.
# Set to "false" to receive notifications only when deals exist.
# Default: true
# SEND_NO_DEALS_NOTIFICATION=true

# ----------------------------------------------------------
# Optional – quota / safety guard
# ----------------------------------------------------------

# Hard monthly cap on the number of Playwright page loads.
# Default: 2000
# MAX_MONTHLY_REQUESTS=2000

# ----------------------------------------------------------
# Optional – deduplication
# ----------------------------------------------------------

# How many days to remember a deal before allowing it to appear again.
# Default: 60
# DEDUP_TTL_DAYS=60

# Path to the JSON file used to store deduplication state and monthly usage.
# Default: ~/.flight_agent/state.json
# FLIGHT_AGENT_STATE_FILE=/path/to/state.json
